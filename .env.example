# ============================================================================
# ContractIQ — Environment Variables
# Copy this file to `.env.local` (Next.js) and fill in real values.
# Values here are intentionally empty. Never commit `.env.local`.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase
# Project → Settings → API (URL + anon key); Settings → API → service_role
# (service role key) — https://supabase.com/dashboard/project/_/settings/api
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=                  # Supabase project URL — safe to expose to the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # Supabase anon/public key — safe to expose to the client (RLS enforces access)
SUPABASE_SERVICE_ROLE_KEY=                 # SERVER ONLY — bypasses RLS; used by lib/supabase/admin.ts and Netlify Scheduled Functions. Never expose to the browser.

# ----------------------------------------------------------------------------
# OpenAI
# https://platform.openai.com/api-keys
# ----------------------------------------------------------------------------
OPENAI_API_KEY=                            # SERVER ONLY — used exclusively by lib/openai/providers/openai.ts for extraction (POST /api/contracts/{id}/process) and chat (POST /api/contracts/{id}/chat). Never expose to the browser.
OPENAI_MONTHLY_BUDGET_USD=500              # SERVER ONLY — operational alert threshold read by netlify/functions/cost-monitor.ts; alert fires at 80% of this value

# ----------------------------------------------------------------------------
# Provider abstraction (fallback readiness — optional, unused unless the
# active provider is switched away from OpenAI per lib/openai/provider.ts)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=                         # SERVER ONLY — only required if lib/openai/providers/anthropic.ts (Claude 3.5 Sonnet fallback) is activated. Leave empty at MVP launch.
GOOGLE_AI_API_KEY=                         # SERVER ONLY — only required if lib/openai/providers/gemini.ts (Gemini 1.5 Pro fallback) is activated. Leave empty at MVP launch.

# ----------------------------------------------------------------------------
# Resend (transactional email — P0 incident notifications to affected users)
# https://resend.com/api-keys
# ----------------------------------------------------------------------------
RESEND_API_KEY=                            # SERVER ONLY — used by lib/email/sendIncidentEmail.ts
RESEND_FROM_EMAIL=                         # e.g. alerts@contractiq.app — must be a verified sending domain in Resend

# ----------------------------------------------------------------------------
# Slack (operational alerting — cost, storage quota, correction-rate drift)
# Create an Incoming Webhook: https://api.slack.com/messaging/webhooks
# ----------------------------------------------------------------------------
SLACK_COST_ALERT_WEBHOOK_URL=              # SERVER ONLY — used by netlify/functions/cost-monitor.ts for the 80%-of-budget and 70%-storage-quota alerts
SLACK_QUALITY_ALERT_WEBHOOK_URL=           # SERVER ONLY — used by netlify/functions/quality-monitor.ts for the >12%/7-day correction-rate alert and calibration warnings

# ----------------------------------------------------------------------------
# Security (skills/security-foundation/SKILL.md)
# ----------------------------------------------------------------------------
MAX_CHAT_HISTORY=100                       # SERVER ONLY — lib/security/tokenLimiter.ts; defense-in-depth ceiling on chat_messages rows loadMessages() may request in one call, independent of the Conversation Memory Layer's own smaller 10/20-turn windows (docs/specs/09-contract-chat-and-realtime.md)

# ----------------------------------------------------------------------------
# Beta / launch-stage feature flags
# ----------------------------------------------------------------------------
BETA_MODE_ENABLED=false                    # SERVER ONLY — "true" during the Measurement Beta stage (caps signups at 50 via beta_access table, enforced in middleware.ts and app/auth/callback/route.ts); set to "false" for Internal Alpha and Public Launch
NEXT_PUBLIC_INCIDENT_BANNER=               # Client-exposed — free-text incident banner message read by app/layout.tsx; empty string means no banner is shown. Toggled manually by the on-call engineer per the incident-response runbook.
NEXT_PUBLIC_CALIBRATION_WARNING=false      # Client-exposed — "true" shows a non-blocking calibration warning banner on results pages. Toggled manually by the product team after the monthly confidence-calibration eval job (tests/eval/calibration.ts) reports >=15% miscalibration.

# ----------------------------------------------------------------------------
# Status page (Instatus — customer communication plan)
# https://instatus.com
# ----------------------------------------------------------------------------
NEXT_PUBLIC_STATUS_PAGE_URL=               # Client-exposed — public status page URL (e.g. https://status.contractiq.app) linked from the footer and incident banner

# ----------------------------------------------------------------------------
# Uptime monitoring (Uptime Robot)
# No app-side env var is required — Uptime Robot is configured externally to
# poll GET /api/health and NEXT_PUBLIC_APP_URL. Listed here for completeness.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=                       # Client-exposed — canonical deployed URL (e.g. https://contractiq.app), used for auth redirect URLs and Uptime Robot target configuration

# ----------------------------------------------------------------------------
# Netlify (deployment platform — set in Netlify UI/CLI, not committed here;
# listed for completeness since the app is deployed as Netlify Functions)
# ----------------------------------------------------------------------------
NETLIFY_SITE_ID=                           # SERVER ONLY — used only by local `netlify dev` / CI deploy scripts, not read at runtime by the app itself
